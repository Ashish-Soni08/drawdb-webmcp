{
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Origin-Agent-Cluster",
                    "value": "?1"
                }
            ]
        }
    ]
}
